+    src:'L.2142-3 — l’affichage des communications syndicales s’effectue librement sur des panneaux réservés à cet usage, DISTINCTS de ceux affectés aux communications du comité ; un exemplaire des communications est transmis à l’employeur simultanément à l’affichage',
+    note:'« Distincts » se prend au mot : un panneau partagé n’est pas conforme. Et l’employeur reçoit copie, il n’autorise pas.'},
+   {k:'registres', n:'9', lib:'Réunir les registres de santé-sécurité en un registre unique, si vous le souhaitez',
+    src:'L.4711-5 — lorsque les informations des articles L.4711-1 et L.4711-2 doivent figurer dans des registres distincts, l’employeur est autorisé à les réunir dans un registre unique dès lors que cette mesure facilite leur conservation et leur consultation',
+    note:'C’est une faculté, pas une obligation : elle simplifie le contrôle, elle ne le remplace pas.'},
+   {k:'releve', n:'10', lib:'VALIDATION — dresser le relevé daté des affichages et informations',
+    src:'aucun texte n’impose ce relevé : c’est la preuve que l’employeur constitue pour lui-même, faute de quoi il lui faudra démontrer un affichage passé sans en avoir gardé trace',
+    echLib:'un an après le relevé, par prudence de gestion',
+    ech:function(D){ return D.releve?parcJours(D.releve,365):''; },
+    note:'Photographiez chaque emplacement, datez, listez ce qui manque et qui s’en charge. Le parcours n’est terminé que lorsque le relevé existe.',
+    doc:['affichages','Pack des informations obligatoires']},
+  ]
+ },
+
+ registre:{
+  titre:'Tenir le registre unique du personnel',
+  sous:'Un registre par établissement, dans l’ordre des embauches et de façon indélébile : les indications de D.1221-23, la partie spécifique aux stagiaires, la copie des titres de travail, la mise à jour au fil des événements, et la mise à disposition du comité et des agents de contrôle.',
+  pre:[
+   {k:'liste', q:'info', lib:'La liste de tous les salariés, dans l’ordre CHRONOLOGIQUE des embauches — c’est ce qu’un agent de contrôle vérifie d’abord'},
+   {k:'mentions', q:'info', lib:'Pour chacun : nationalité, date de naissance, sexe, emploi, qualification, dates d’entrée et de sortie'},
+   {k:'titres', q:'piece', lib:'La copie des titres autorisant l’activité salariée des travailleurs étrangers'},
+   {k:'autoris', q:'piece', lib:'Les dates des autorisations d’embauche ou de licenciement, lorsqu’une autorisation est requise — à défaut, la date de la demande'},
+   {k:'stag', q:'info', lib:'La liste des stagiaires et des volontaires en service civique accueillis, dans leur ordre d’arrivée'},
+   {k:'etabs', q:'info', lib:'La liste des établissements où sont employés des salariés : un registre par établissement, la centralisation ne dispense pas de la tenue sur place'},
+   {k:'avis', q:'doc', lib:'L’avis du comité social et économique sur le support de substitution informatique, s’il en est fait usage'},
+  ],
+  dates:[
+   {k:'ouv', lib:'Date d’ouverture ou de reprise du registre', aide:'Elle date la tenue et sert de repère au contrôle.'},
+   {k:'avis', lib:'Date de l’avis du comité sur le support de substitution', aide:'L’article D.1221-27 impose d’adresser cet avis à l’inspection du travail ; il ne fixe pas de délai.'},
+  ],
+  etapes:[
+   {k:'ouvrir', n:'1', lib:'Ouvrir un registre par établissement',
+    src:'L.1221-13 — un registre unique du personnel est tenu dans TOUT établissement où sont employés des salariés',
+    echLib:'la date d’ouverture que vous avez retenue',
+    ech:function(D){ return D.ouv||''; },
+    note:'Si l’entreprise compte plusieurs établissements, elle compte autant de registres. Un registre unique centralisé au siège ne satisfait pas le texte.'},
+   {k:'ordre', n:'2', lib:'Inscrire les noms et prénoms dans l’ordre des embauches, de façon indélébile',
+    src:'L.1221-13 — les mentions sont portées sur le registre au moment de l’embauche et de façon indélébile',
+    note:'« Au moment de l’embauche » : pas à la fin du mois, pas quand le contrat revient signé — au moment où le salarié entre.'},
+   {k:'stag', n:'3', lib:'Ouvrir la partie spécifique aux stagiaires et aux volontaires en service civique',
+    src:'L.1221-13 — les nom et prénoms des stagiaires et des personnes volontaires en service civique accueillis dans l’établissement sont inscrits dans l’ordre d’arrivée, dans une partie SPÉCIFIQUE du registre',
+    note:'Une partie spécifique, donc distincte de celle des salariés : les mélanger est la deuxième irrégularité la plus fréquente sur ce registre.'},
+   {k:'mentions', n:'4', lib:'Porter les indications complémentaires de D.1221-23',
+    src:'D.1221-23 — nationalité, date de naissance, sexe, emploi, qualification, dates d’entrée et de sortie, date de l’autorisation d’embauche ou de licenciement lorsqu’elle est requise, titre autorisant l’activité salariée pour les travailleurs étrangers, et les mentions « contrat à durée déterminée », « salarié temporaire », « mis à disposition par un groupement d’employeurs », « salarié à temps partiel », « apprenti » ou « contrat de professionnalisation »',
+    note:'Le module Personnel de cette application tient ces colonnes et les imprime : il n’y a pas de raison de les tenir à la main.'},
+   {k:'titres', n:'5', lib:'Annexer la copie des titres de travail des salariés étrangers',
+    src:'D.1221-24 — une copie des titres autorisant l’exercice d’une activité salariée est annexée au registre et rendue accessible aux membres de la délégation du personnel du comité et aux agents de contrôle, dans l’établissement ou sur chaque chantier où ces travailleurs sont employés',
+    note:'« Sur chaque chantier » : pour une activité mobile, la copie suit le salarié, elle ne reste pas au siège.'},
+   {k:'maj', n:'6', lib:'Mettre à jour au moment où l’événement survient',
+    src:'D.1221-25 — les mentions relatives à des événements postérieurs à l’embauche du salarié, ou à l’arrivée du stagiaire, sont portées sur le registre au moment où ceux-ci surviennent',
+    note:'Une sortie inscrite trois mois plus tard est une sortie non inscrite.'},
+   {k:'subst', n:'7', lib:'Régulariser le support de substitution informatique',
+    src:'D.1221-27 — lorsque l’employeur recourt à un support de substitution, les exigences des articles D.8113-2 et D.8113-3 sont applicables, et il adresse à l’inspection du travail l’avis du comité prévu à l’article L.2315-5',
+    echLib:'la date d’avis que vous avez saisie',
+    ech:function(D){ return D.avis||''; },
+    note:'Le texte n’impose pas de délai pour cet envoi : ce qu’il impose, c’est qu’il ait lieu — et qu’il puisse se prouver.'},
+   {k:'dispo', n:'8', lib:'VALIDATION — tenir le registre à la disposition du comité et des agents de contrôle',
+    src:'L.1221-15 — le registre unique du personnel est tenu à la disposition du comité social et économique et des fonctionnaires et agents chargés de veiller à l’application du code du travail et du code de la sécurité sociale',
+    note:'Datez cette mise à disposition, dites où le registre se consulte, et informez-en les élus par écrit : le parcours n’est terminé que lorsque le registre est consultable et que quelqu’un le sait.'},
+  ]
+ },
+
+ bdese:{
+  titre:'Constituer la base de données économiques, sociales et environnementales',
+  sous:'L’accord d’abord, le régime supplétif ensuite : ce qu’un accord peut définir, ce que la base doit contenir à défaut selon l’effectif, l’accès permanent des élus et des délégués syndicaux, et la mise à disposition qui vaut communication.',
+  seuil:[50,'L.2312-18'],
+  pre:[
+   {k:'acc', q:'doc', lib:'L’accord d’entreprise définissant l’organisation, l’architecture, le contenu et les modalités de fonctionnement de la base, s’il en existe un (L.2312-21)'},
+   {k:'branche', q:'doc', lib:'À défaut, l’accord de branche — L.2312-21 ne l’ouvre qu’aux entreprises de moins de trois cents salariés'},
+   {k:'eff', q:'info', lib:'L’effectif de l’entreprise : c’est lui qui désigne le contenu supplétif applicable, celui de R.2312-8 ou celui de R.2312-9'},
+   {k:'compta', q:'doc', lib:'Les comptes des deux exercices précédents et les prévisions de l’exercice en cours'},
+   {k:'social', q:'doc', lib:'Les données sociales : effectifs, contrats, rémunérations, formation, conditions de travail'},
+   {k:'egalite', q:'info', lib:'Les indicateurs relatifs à l’égalité professionnelle entre les femmes et les hommes'},
+   {k:'support', q:'info', lib:'Le support retenu — informatique ou papier — et le moyen d’en assurer l’accès permanent'},
+   {k:'elus', q:'info', lib:'La liste des membres du comité et des délégués syndicaux, qui doivent y accéder en permanence'},
+  ],
+  dates:[
+   {k:'dispo', lib:'Date de mise à disposition, ou de dernière actualisation', aide:'C’est elle qui fait courir le délai d’examen des consultations récurrentes : la mise à disposition vaut communication.'},
+  ],
+  etapes:[
+   {k:'regime', n:'1', lib:'Déterminer le régime : accord, accord de branche, ou supplétif',
+    src:'L.2312-21 — un accord d’entreprise ou, en l’absence de délégué syndical, un accord entre l’employeur et le comité adopté à la majorité des membres titulaires, définit l’organisation, l’architecture, le contenu et les modalités de fonctionnement de la base ; à défaut, un accord de branche pour les entreprises de moins de trois cents salariés',
+    note:'Trois voies dans l’ordre. Appliquer le supplétif alors qu’un accord existe, c’est méconnaître l’accord ; l’inverse est une carence.'},
+   {k:'themes', n:'2', lib:'Vérifier les thèmes que la base comporte au moins',
+    src:'L.2312-18 — la base comporte l’ensemble des informations nécessaires aux consultations et informations récurrentes que l’employeur met à disposition du comité ; l’accord ne peut réduire en deçà des thèmes que ce texte énumère',
+    note:'Même sous accord, un thème manquant est un thème manquant : l’accord organise, il ne retranche pas.'},
+   {k:'supple', n:'3', lib:'À défaut d’accord, reprendre le contenu supplétif propre à l’effectif',
+    src:'R.2312-8 — contenu à défaut d’accord dans les entreprises de moins de trois cents salariés · R.2312-9 — contenu à défaut d’accord dans les entreprises d’au moins trois cents salariés',
+    note:'Les deux tableaux ne se ressemblent pas : le second est nettement plus détaillé. Prenez celui de votre effectif, rubrique par rubrique.'},
+   {k:'egalite', n:'4', lib:'Y verser les indicateurs d’égalité et le bilan des formations',
+    src:'L.2312-36 — la base comporte notamment les informations relatives à l’égalité professionnelle entre les femmes et les hommes, dont les indicateurs et les écarts de rémunération',
+    note:'C’est la même matière que l’index et que la négociation sur l’égalité : les trois doivent dire la même chose, sous peine d’être opposés l’un à l’autre.'},
+   {k:'acces', n:'5', lib:'Ouvrir l’accès permanent aux élus et aux délégués syndicaux',
+    src:'L.2312-36 — la base est accessible en permanence aux membres de la délégation du personnel du comité social et économique et aux délégués syndicaux',
+    note:'« En permanence » : un envoi ponctuel de fichiers n’est pas un accès permanent. Un support papier n’est pas interdit, mais il rend cet accès difficile à assurer.'},
+   {k:'notif', n:'6', lib:'Notifier la mise à disposition — elle vaut communication',
+    src:'la mise à disposition dans la base des éléments d’information vaut communication des rapports et informations au comité (L.2312-18) : c’est de cette mise à disposition que court le délai d’examen',
+    echLib:'la date de mise à disposition que vous avez saisie',
+    ech:function(D){ return D.dispo||''; },
+    note:'Notifiez-la par écrit et datez-la : sans cette date, le délai d’examen ne court pas, et la consultation reste ouverte.'},
+   {k:'audit', n:'7', lib:'VALIDATION — auditer la base rubrique par rubrique',
+    src:'aucun texte n’impose cet audit : c’est la vérification que la base contient réellement ce que le régime applicable exige, rubrique par rubrique',
+    note:'Le parcours n’est terminé que lorsque chaque rubrique due a été pointée présente ou manquante, avec un responsable et une échéance pour chaque manque.'},
+  ]
+ },
+
+ index:{
+  titre:'Calculer et publier l’index de l’égalité professionnelle',
+  sous:'Cinq indicateurs, un résultat sur cent, une publication au 1er mars, une mise à disposition du comité et une télédéclaration — et, sous le seuil, des mesures de correction à publier et un délai de trois ans qui court.',
+  seuil:[50,'L.1142-8'],
+  pre:[
+   {k:'paie', q:'doc', lib:'Les données de paie de la période de référence : rémunérations, catégories, âges, sexes'},
+   {k:'augm', q:'info', lib:'La liste des augmentations individuelles et des promotions de la période'},
+   {k:'mat', q:'info', lib:'La liste des salariées revenues de congé de maternité pendant la période'},
+   {k:'hautes', q:'info', lib:'Les dix plus hautes rémunérations et leur répartition par sexe'},
+   {k:'periode', q:'info', lib:'La période de référence retenue et son caractère constant d’une année sur l’autre'},
+   {k:'outil', q:'doc', lib:'L’outil de calcul utilisé et la trace des paramètres retenus — c’est lui qu’il faudra pouvoir montrer'},
+  ],
+  dates:[
+   {k:'cloture', lib:'Clôture de la période de référence retenue', aide:'Elle commande la date de publication : au plus tard le 1er mars suivant.'},
+   {k:'pub', lib:'Date de publication de l’index', aide:'Elle date la preuve à conserver, et fait courir le délai de correction en cas de résultat insuffisant.'},
+  ],
+  etapes:[
+   {k:'assuj', n:'1', lib:'Vérifier l’assujettissement et le périmètre de calcul',
+    src:'L.1142-8 — dans les entreprises d’au moins cinquante salariés, l’employeur publie chaque année des indicateurs relatifs aux écarts de rémunération entre les femmes et les hommes et aux actions mises en œuvre pour les supprimer',
+    note:'Le périmètre est celui de l’entreprise, non de l’établissement. La période de référence se choisit une fois et ne se change pas au gré du résultat.'},
+   {k:'calcul', n:'2', lib:'Calculer les cinq indicateurs',
+    src:'D.1142-2 — pour les entreprises de plus de deux cent cinquante salariés, les cinq indicateurs sont : l’écart de rémunération, l’écart de taux d’augmentations individuelles hors promotions, l’écart de taux de promotions, le pourcentage de salariées augmentées au retour de congé de maternité, et le nombre de salariés du sexe sous-représenté parmi les dix plus hautes rémunérations',
+    note:'En deçà de deux cent cinquante salariés, la liste des indicateurs n’est pas la même : prenez la version du texte qui vise votre effectif. Conservez la feuille de calcul et les paramètres retenus.'},
+   {k:'niveau', n:'3', lib:'Déterminer le niveau de résultat',
+    src:'D.1142-3 — le niveau de résultat obtenu au regard des indicateurs est déterminé selon les modalités fixées aux annexes du chapitre',
+    note:'Le résultat se calcule sur cent points. Un indicateur incalculable n’est pas un indicateur nul : le texte prévoit son traitement, vérifiez-le.'},
+   {k:'publier', n:'4', lib:'Publier au plus tard le 1er mars',
+    src:'D.1142-4 — le niveau de résultat et les résultats de chaque indicateur sont publiés annuellement, au plus tard le 1er mars de l’année en cours au titre de l’année précédente, de manière visible et lisible sur le site internet de l’entreprise lorsqu’il en existe un',
+    echLib:'au plus tard le 1er mars suivant la clôture',
+    ech:function(D){ if(!D.cloture) return ''; var a=parseInt(String(D.cloture).slice(0,4),10); return (a+1)+'-03-01'; },
+    note:'« Visible et lisible » : une page à trois clics de profondeur ne l’est pas. Conservez une capture datée de la page publiée.'},
+   {k:'cse', n:'5', lib:'Mettre les indicateurs à la disposition du comité et télédéclarer',
+    src:'D.1142-5 — les indicateurs et le niveau de résultat sont mis à la disposition du comité social et économique selon la même périodicité, dans les conditions du deuxième alinéa de l’article L.2312-18, présentés par catégorie socio-professionnelle',
+    note:'Trois destinataires distincts : le public, le comité, l’administration. Un seul des trois oublié suffit à caractériser le manquement.'},
+   {k:'correction', n:'6', lib:'Sous soixante-quinze points : arrêter et publier les mesures de correction',
+    src:'L.1142-9 — lorsque les résultats se situent en deçà du niveau défini par décret, la négociation sur l’égalité professionnelle porte aussi sur les mesures de correction et, le cas échéant, sur la programmation de mesures financières de rattrapage salarial · D.1142-6 — ces mesures doivent être mises en œuvre dès lors que le niveau de résultat est inférieur à SOIXANTE-QUINZE points, et elles sont publiées sur le site internet de l’entreprise',
+    note:'Les mesures se négocient d’abord ; à défaut d’accord, elles sont décidées unilatéralement après consultation du comité. Elles se publient comme l’index lui-même.'},
+   {k:'delai', n:'7', lib:'Mesurer le délai de trois ans et l’exposition à la pénalité',
+    src:'L.1142-10 — en deçà du niveau défini par décret, l’entreprise dispose d’un délai de TROIS ANS pour se mettre en conformité ; à l’expiration de ce délai, une pénalité financière d’un maximum de 1 % des rémunérations peut être appliquée',
+    echLib:'trois ans après la publication du résultat insuffisant',
+    ech:function(D){ return D.pub?parcMois(D.pub,36):''; },
+    note:'Le délai court de la publication, non de la constatation interne : datez la publication et posez l’échéance.'},
+   {k:'mille', n:'8', lib:'À partir de mille salariés : publier les écarts de représentation',
+    min:1000,
+    src:'L.1142-11 — dans les entreprises qui, pour le troisième exercice consécutif, emploient au moins mille salariés, l’employeur publie chaque année les écarts éventuels de représentation entre les femmes et les hommes parmi les cadres dirigeants et les membres des instances dirigeantes',
+    note:'C’est une publication DISTINCTE de l’index : elle a son propre périmètre et son propre calendrier.'},
+   {k:'preuve', n:'9', lib:'VALIDATION — conserver la preuve de la publication et de la télédéclaration',
+    src:'aucun texte n’impose de dossier de preuve : c’est ce qui manque toujours au moment du contrôle',
+    echLib:'la date de publication que vous avez saisie',
+    ech:function(D){ return D.pub||''; },
+    note:'Capture datée de la page publiée, accusé de télédéclaration, procès-verbal de mise à disposition au comité, feuille de calcul et paramètres. Le parcours n’est terminé que lorsque ces quatre pièces existent.'},
+  ]
+ },
+
+ entretiens:{
+  titre:'Organiser les entretiens de parcours professionnel',
+  sous:'Un entretien la première année, puis tous les quatre ans au plus, un état des lieux tous les huit ans, cinq sujets à couvrir et un sujet à ne pas aborder — et, dès cinquante salariés, l’abondement correctif qui sanctionne l’oubli.',
+  pre:[
+   {k:'liste', q:'info', lib:'La liste des salariés avec leur date d’entrée et la date de leur dernier entretien'},
+   {k:'huit', q:'info', lib:'La liste de ceux qui atteignent huit ans de présence dans l’année : l’état des lieux récapitulatif leur est dû'},
+   {k:'form', q:'info', lib:'Les formations suivies par chacun, en distinguant celles qui conditionnent l’exercice de l’activité des autres'},
+   {k:'abs', q:'info', lib:'La liste des absences longues achevées : maternité, adoption, parental, proche aidant, sabbatique, mandat, arrêt long'},
+   {k:'trame', q:'doc', lib:'La trame d’entretien, et la preuve qu’elle ne sert pas à évaluer le travail'},
+   {k:'copie', q:'doc', lib:'Le modèle de document remis au salarié, dont il conserve copie'},
+  ],
+  dates:[
+   {k:'embauche', lib:'Date d’embauche du salarié concerné', aide:'Le premier entretien est dû dans l’année qui suit ; l’état des lieux, tous les huit ans.'},
+   {k:'dernier', lib:'Date du dernier entretien tenu', aide:'Le suivant est dû au plus tard quatre ans après.'},
+  ],
+  etapes:[
+   {k:'info', n:'1', lib:'Informer le salarié à l’embauche',
+    src:'L.6315-1 — le salarié est informé, lors de son embauche, qu’il bénéficie tous les deux ans d’un entretien professionnel consacré à ses perspectives d’évolution professionnelle ; la version en vigueur lue à la source porte un entretien dans l’année suivant l’embauche puis tous les quatre ans au plus',
+    note:'La périodicité a changé : ne recopiez pas une trame ancienne. C’est la version en vigueur à votre date qui commande, et c’est elle qui est citée ici.'},
+   {k:'premier', n:'2', lib:'Tenir l’entretien de la première année',
+    src:'L.6315-1 — l’entretien professionnel est proposé dans l’année qui suit l’embauche',
+    echLib:'un an après l’embauche',
+    ech:function(D){ return D.embauche?parcMois(D.embauche,12):''; },
+    note:'« Proposé » n’est pas « tenu » : gardez trace de la proposition ET de la tenue, ou du refus du salarié.',
+    doc:['entretien','Trame d’entretien professionnel']},
+   {k:'suivant', n:'3', lib:'Renouveler tous les quatre ans au plus',
+    src:'L.6315-1 — l’entretien est ensuite renouvelé selon la périodicité que fixe le texte en vigueur, quatre ans au plus dans la version lue à la source ; un accord d’entreprise ou de branche peut fixer une périodicité différente',
+    echLib:'quatre ans après le dernier entretien',
+    ech:function(D){ return D.dernier?parcMois(D.dernier,48):''; },
+    note:'Vérifiez d’abord s’il existe un accord : il peut fixer une autre périodicité, et c’est alors lui qui s’applique.',
+    doc:['entretien','Trame d’entretien professionnel']},
+   {k:'sujets', n:'4', lib:'Couvrir les sujets dus — et ne pas évaluer le travail',
+    src:'L.6315-1 — l’entretien est consacré aux perspectives d’évolution professionnelle, notamment en termes de qualifications et d’emploi ; il comporte des informations relatives à la validation des acquis de l’expérience, à l’activation du compte personnel de formation, aux abondements que l’employeur est susceptible de financer et au conseil en évolution professionnelle',
+    note:'L’entretien professionnel NE PORTE PAS sur l’évaluation du travail du salarié : le texte le dit. Mêler les deux dans une même trame est le défaut le plus fréquent, et il prive l’entretien de sa qualification.',
+    doc:['entretien','Trame d’entretien professionnel']},
+   {k:'retour', n:'5', lib:'Proposer l’entretien au retour d’une absence longue',
+    src:'L.6315-1 — l’entretien est proposé systématiquement au salarié qui reprend son activité à l’issue des congés et absences que ce texte énumère, dont le congé de maternité, le congé parental, le congé de proche aidant, le congé sabbatique, la période de mobilité volontaire sécurisée, un arrêt longue maladie ou un mandat syndical',
+    note:'« Systématiquement » : la proposition ne dépend pas d’une demande du salarié. Elle se trace au retour, pas au prochain cycle.',
+    doc:['entretien','Trame d’entretien professionnel']},
+   {k:'doc', n:'6', lib:'Rédiger le document et en remettre copie au salarié',
+    src:'L.6315-1 — chaque entretien donne lieu à la rédaction d’un document dont une copie est remise au salarié',
+    note:'Sans copie remise, l’entretien ne se prouve pas — et un entretien qui ne se prouve pas n’a pas eu lieu au regard de l’abondement correctif.',
