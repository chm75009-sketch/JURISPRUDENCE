+        + 'rel="noopener" style="color:#c9a84c;font-weight:700">la procédure pas à pas — « '
+        + jxpEsc(d.n) + ' » ↗</a>';
+  h += '.</div>';
+  if(box.innerHTML !== h) box.innerHTML = h;
+}
+
+/* Le fragment d'adresse : « …/index.html#/ri » ouvre la page « ri ».
+   Lu une seule fois, au chargement, et seulement vers une page existante.
+   Le fragment n'est jamais écrit : la navigation de l'application reste ce
+   qu'elle était, et aucune page ne change de comportement sans fragment. */
+function jxpFragment(){
+  var f = '';
+  try{ f = String(location.hash||''); }catch(e){ return; }
+  var m = /^#\/?([A-Za-z0-9_-]+)$/.exec(f);
+  if(!m) return;
+  var id = m[1];
+  if(!document.getElementById('pg-'+id)) return;
+  try{ goPage(id); }catch(e){}
+}
+try{
+  if(document.readyState!=='loading') setTimeout(jxpFragment, 600);
+  else document.addEventListener('DOMContentLoaded', function(){ setTimeout(jxpFragment, 600); });
+}catch(e){}
+</script>
+
+<!-- ═══════════════════════════════════════════════════════════════════════
+     LA FICHE ENTREPRISE S'EMPORTE — format « profil-entreprise », version 1.
+
+     Les deux applications posaient les mêmes questions : dénomination,
+     SIRET, adresse, effectif, secteur, convention. Deux fois. Un fichier
+     JSON descend d'ici et remonte là-bas, et réciproquement. Ni serveur, ni
+     compte, ni synchronisation : le SIRET et le courriel d'un client sont
+     des données personnelles, et un fichier n'exige ni responsable de
+     traitement ni durée de conservation.
+
+     Le schéma est décrit dans PROFIL-PARTAGE.md, à la racine des deux
+     dépôts. Il ne change pas sans changer de numéro de version.
+
+     CE QUI N'EST PAS DÉDUIT — et c'est l'essentiel.
+
+     • L'EFFECTIF n'est exporté que s'il est CALCULÉ (registre du personnel).
+       La fiche ne connaît sinon qu'une TRANCHE : écrire « 50 » parce que la
+       tranche commence à 50 serait inventer un chiffre. La tranche reste
+       ici ; le fichier n'en dit rien.
+     • À l'import, un effectif exact se range dans la tranche qui le
+       contient. Ce n'est pas une déduction : c'est un classement plus large
+       d'une donnée plus précise.
+     • LE SECTEUR ne s'importe pas. Ici, un secteur est un CODE qui commande
+       tout l'affichage ; là-bas, c'est un texte libre. Reconnaître
+       « transport et logistique » comme le code « transport » serait une
+       supposition. Le fichier est donc lu, et le champ laissé au client.
+     • LE GROUPE n'est PAS le même champ des deux côtés : ici la question est
+       « entreprise ou groupe d'au moins 1 000 salariés », là-bas « appartient
+       à un groupe ». Deux questions différentes : aucune ne répond à
+       l'autre, et rien n'est transporté entre elles.
+     • CE QUI N'EST PAS COMPRIS N'EST PAS PERDU : les champs que cette
+       application ne sait pas lire sont conservés tels quels et réémis à
+       l'export suivant. Un aller-retour ne dégrade rien.
+     ═══════════════════════════════════════════════════════════════════ -->
+<script>
+var JXPROF_FORMAT = 'profil-entreprise';
+var JXPROF_VERSION = 1;
+var JXPROF_APP = 'JURIS EXPERT MCH — générateurs de documents';
+
+/* Ce que cette fiche sait dire, dans le vocabulaire commun. */
+function jxProfilExporter(){
+  var f = (typeof E!=='undefined' && E) ? E : {};
+  var out = {};
+  /* Ce qu'un import précédent portait et que l'on ne sait pas lire :
+     conservé à l'identique, réémis en premier, puis recouvert par ce que
+     cette application connaît réellement. */
+  try{
+    var garde = f.profilEchange;
+    if(garde && typeof garde==='object')
+      Object.keys(garde).forEach(function(k){
+        var v = garde[k];
+        if(v!==undefined && v!==null && String(v).trim()!=='') out[k]=String(v);
+      });
+  }catch(e){}
+
+  function jxpPose(cle, val){
+    if(val===undefined || val===null) return;
+    val = String(val).trim();
+    if(val==='') return;
+    out[cle] = val;
+  }
+  jxpPose('denomination', f.nom);
+  jxpPose('siret', f.siret);
+  jxpPose('adresse', f.adresse);
+  jxpPose('responsable', [f.dirigeant, f.qualite].filter(function(x){
+    return x && String(x).trim()!==''; }).join(', '));
+  jxpPose('courriel', f.email);
+  jxpPose('telephone', f.tel);
+  /* L'effectif CALCULÉ, et lui seul. Une tranche n'est pas un chiffre. */
+  try{
+    var n = (typeof cseEffectif==='function') ? cseEffectif() : null;
+    if(n!==null && isFinite(n)) jxpPose('effectif', String(n));
+  }catch(e){}
+  /* Le secteur part sous son intitulé lisible : là-bas, le champ accepte
+     le texte libre. */
+  try{
+    if(f.secteur && typeof SECTEUR_LAB!=='undefined' && SECTEUR_LAB[f.secteur])
+      jxpPose('secteur', SECTEUR_LAB[f.secteur]);
+  }catch(e){}
+  /* La convention : celle qui a été confirmée, ou celle qui a été précisée.
+     « je ne sais pas » et « aucune » ne sont pas une convention : rien ne
+     part. */
+  try{
+    if(f.ccn==='autre') jxpPose('conventionCollective', f.ccnAutre);
+    else if(f.ccn==='secteur' && typeof SECTEUR_LAB!=='undefined' && SECTEUR_LAB[f.secteur])
+      jxpPose('conventionCollective', SECTEUR_LAB[f.secteur]);
+  }catch(e){}
+  if(f.etabs==='un') jxpPose('etablissementsDistincts','non');
+  else if(f.etabs==='plusieurs') jxpPose('etablissementsDistincts','oui');
+  if(f.etabs==='plusieurs' && f.etabsListe){
+    var lignes = String(f.etabsListe).split('\n').map(function(x){ return x.trim(); })
+      .filter(function(x){ return x!==''; });
+    if(lignes.length) jxpPose('nbEtablissements', String(lignes.length));
+  }
+  return { format: JXPROF_FORMAT, version: JXPROF_VERSION, emisPar: JXPROF_APP,
+           emisLe: new Date().toISOString(), entreprise: out };
+}
+
+function jxProfilNomFichier(){
+  var f = (typeof E!=='undefined' && E) ? E : {};
+  var d = String(f.nom||'').normalize('NFD').replace(/[̀-ͯ]/g,'')
+    .replace(/[^A-Za-z0-9]+/g,'-').replace(/^-|-$/g,'').toLowerCase();
+  return 'profil-entreprise' + (d?('-'+d):'') + '-' +
+    new Date().toISOString().slice(0,10) + '.json';
+}
+
+function jxProfilTelecharger(){
+  try{
+    var texte = JSON.stringify(jxProfilExporter(), null, 1);
+    var url = URL.createObjectURL(new Blob([texte], {type:'application/json'}));
+    var a = document.createElement('a');
+    a.href = url; a.download = jxProfilNomFichier();
+    document.body.appendChild(a); a.click(); a.remove();
+    setTimeout(function(){ URL.revokeObjectURL(url); }, 4000);
+    jxProfilDire('Fiche téléchargée. Elle s’importe dans JURISPRUDENCE, sous la fiche client de l’audit social.', true);
+  }catch(e){ jxProfilDire('Le téléchargement n’a pas abouti sur ce navigateur.', false); }
+}
+
+function jxProfilDire(msg, ok){
+  var z = document.getElementById('p-echange-etat');
+  if(!z) return;
+  z.textContent = msg;
+  z.style.color = ok ? '#8fbf9f' : '#e0a0a0';
+}
+
+/* La lecture d'un fichier reçu. Rien n'est deviné, rien n'est écrasé par du
+   vide : jxEntEcrire fusionne, et un champ absent du fichier reste ce
+   qu'il était. */
+function jxProfilImporter(objet){
+  if(!objet || typeof objet!=='object')
+    return { ok:false, message:'Fichier illisible : ce n’est pas du JSON.' };
+  if(objet.format!==JXPROF_FORMAT)
+    return { ok:false, message:'Ce fichier n’est pas un profil d’entreprise (champ « format » attendu : « '+JXPROF_FORMAT+' »).' };
+  if(objet.version!==JXPROF_VERSION)
+    return { ok:false, message:'Version de format inconnue ('+JSON.stringify(objet.version)+') : cette application lit la version '+JXPROF_VERSION+'.' };
+  var src = objet.entreprise;
+  if(!src || typeof src!=='object')
+    return { ok:false, message:'Le fichier ne porte aucune entreprise.' };
+
+  function v(c){
+    var x = src[c];
+    if(x===undefined || x===null) return '';
+    return String(x).trim();
+  }
+  var neuf = {}, pris = [], ignores = [];
+  function prend(cible, val, nom){
+    if(!val) return;
+    neuf[cible] = val; pris.push(nom||cible);
+  }
+  prend('nom', v('denomination'), 'dénomination');
+  prend('siret', v('siret'), 'SIRET');
+  prend('adresse', v('adresse'), 'adresse');
+  prend('email', v('courriel'), 'courriel');
+  prend('tel', v('telephone'), 'téléphone');
+  /* Le responsable arrive en une chaîne « Nom, qualité ». On ne la coupe
+     que si la qualité y figure telle qu'elle est proposée ici ; sinon tout
+     va au nom, et rien n'est inventé. */
+  var resp = v('responsable');
+  if(resp){
+    var m = /^(.*?),\s*(Gérant|Président|Directeur Général)\s*$/.exec(resp);
+    if(m){ prend('dirigeant', m[1].trim(), 'dirigeant'); prend('qualite', m[2], 'qualité'); }
+    else prend('dirigeant', resp, 'dirigeant');
+  }
+  var ccn = v('conventionCollective');
+  if(ccn){ neuf.ccn='autre'; neuf.ccnAutre=ccn; pris.push('convention collective'); }
+  var ed = v('etablissementsDistincts');
+  if(ed==='oui'){ neuf.etabs='plusieurs'; pris.push('établissements distincts'); }
+  else if(ed==='non'){ neuf.etabs='un'; pris.push('établissements distincts'); }
+  /* L'effectif exact se range dans SA tranche : un chiffre plus précis
+     entre dans un intervalle plus large, ce n'est pas une supposition. */
+  var eff = v('effectif');
+  if(eff && /^\d+$/.test(eff)){
+    try{
+      var n = parseInt(eff,10), t=null;
+      jxTranches().forEach(function(x){ if(n>=x.min && (x.max===null || n<=x.max)) t=x; });
+      if(t){ neuf.effectif=t.v; pris.push('effectif ('+eff+' salariés → « '+t.lib+' »)'); }
+    }catch(e){}
+  }
+  if(v('secteur')) ignores.push('secteur');
+  if(v('groupe')) ignores.push('groupe');
+  if(v('nbEtablissements')) ignores.push('nombre d’établissements');
+
+  /* Rien de perdu : ce qui n'a pas été repris reste dans la fiche, à
+     l'identique, et repartira à l'export suivant. */
+  var garde = {};
+  Object.keys(src).forEach(function(k){
+    var x = src[k];
+    if(x===undefined || x===null || String(x).trim()==='') return;
+    garde[k] = String(x);
+  });
+  if(Object.keys(garde).length) neuf.profilEchange = garde;
+
+  if(!pris.length)
+    return { ok:false, message:'Le fichier ne porte aucun champ que cette fiche sache reprendre.' };
+  if(typeof E==='undefined' || !E)
+    return { ok:false, message:'La fiche entreprise n’est pas chargée.' };
+  Object.keys(neuf).forEach(function(k){ E[k]=neuf[k]; });
+  if(!jxEntEcrire(E)) return { ok:false, message:'L’enregistrement a échoué sur cet appareil.' };
+  try{ chargerParametres(); }catch(e){}
+  try{ updateHeroTop(); }catch(e){}
+  return { ok:true, message: pris.length+' champ(s) repris : '+pris.join(', ')+'.'
+    + (ignores.length ? ' Non repris, pour ne rien supposer : '+ignores.join(', ')
+      +' — à choisir vous-même ci-dessus.' : '') };
+}
+
+function jxProfilImporterFichier(input){
+  var f = input && input.files && input.files[0];
+  if(!f) return;
+  var lect = new FileReader();
+  lect.onload = function(){
+    var o=null;
+    try{ o = JSON.parse(String(lect.result)); }catch(e){ o=null; }
+    var r = jxProfilImporter(o);
+    jxProfilDire(r.message, r.ok);
+  };
+  lect.onerror = function(){ jxProfilDire('Le fichier n’a pas pu être lu.', false); };
+  lect.readAsText(f);
+  input.value='';
+}
+
+function jxProfilChoisir(){
+  var i = document.getElementById('p-echange-fichier');
+  if(i) i.click();
+}
+</script>
